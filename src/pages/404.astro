---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import Button from "../components/Button.astro";
---

<BaseLayout
  title="Página no encontrada | Journaling Terapéutico"
  description="La página que buscas no existe o fue movida."
  path="/404.html"
>
  <main class="mx-auto flex max-w-2xl flex-col items-center gap-6 px-6 py-24 text-center md:px-10">
    <Icon name="pen-nib" class="h-12 w-12 text-primary-text" />
    <p class="font-display text-6xl font-semibold text-ink">404</p>
    <h1 class="text-3xl font-bold text-ink">Esta página se perdió entre las hojas del diario</h1>
    <p class="text-lg text-body">
      No encontramos lo que buscabas. Puede que el link esté roto o que la página se haya movido.
    </p>
    <div class="mt-4 flex flex-col gap-3 sm:flex-row">
      <Button href="/">Volver a Inicio</Button>
      <Button href="/contact.html" variant="outline">Contáctanos</Button>
    </div>
  </main>
</BaseLayout>
