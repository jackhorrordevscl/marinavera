---
import BaseLayout from "../layouts/BaseLayout.astro";
import AgendaForm from "../components/AgendaForm.astro";
import Icon from "../components/Icon.astro";
import Button from "../components/Button.astro";
import { courses } from "../data/courses.js";
---

<BaseLayout
  title="Acompañamientos | Journaling En Red"
  description="Descubre el Acompañamiento Individual de Journaling Guiado de Journaling En Red: 6 sesiones personalizadas con enfoque psicosocial para tu bienestar emocional."
  path="/class.html"
  current="class"
>
  <main class="mx-auto flex max-w-6xl flex-col gap-16 px-6 py-16 md:px-10">
    <header class="mx-auto max-w-3xl space-y-4 text-center">
      <h1 class="text-4xl font-bold text-ink md:text-5xl">Programas de Acompañamiento</h1>
      <p class="text-lg text-body">
        Espacios individuales y seguros donde utilizamos el journaling guiado con enfoque psicosocial como
        herramienta principal para explorar, comprender y fortalecer tu bienestar.
      </p>
    </header>

    <div class="flex flex-col gap-10">
      {
        courses.map((course) => (
          <article
            id={course.slug}
            class="scroll-mt-24 flex flex-col gap-8 rounded-2xl border border-border bg-card p-8 shadow-soft md:p-10 lg:flex-row"
          >
            <div class="flex-grow space-y-8">
              <div class="space-y-3">
                <div class="flex flex-wrap items-center gap-3">
                  <span class="rounded-full bg-secondary-soft px-3 py-1 text-xs font-bold text-secondary-text">
                    {course.badge}
                  </span>
                  <h2 class="text-2xl font-semibold text-ink md:text-3xl">{course.title}</h2>
                </div>
                <p class="text-sm font-bold uppercase tracking-[0.15em] text-primary-text">{course.subtitle}</p>
              </div>

              <div class="space-y-4">
                {course.description.map((paragraph) => (
                  <p class="text-body">{paragraph}</p>
                ))}
              </div>

              <p class="rounded-xl border border-border bg-surface p-4 text-sm font-semibold text-body">
                {course.disclaimer}
              </p>

              <div class="grid grid-cols-1 gap-8 sm:grid-cols-2">
                <div>
                  <h3 class="mb-3 flex items-center gap-2 text-sm font-bold text-secondary-text">
                    <Icon name="user" class="h-3.5 w-3.5" /> ¿Este acompañamiento es para ti?
                  </h3>
                  <ul class="space-y-1.5 text-sm text-body">
                    {course.audience.map((item) => (
                      <li class="flex gap-2">
                        <Icon name="check" class="mt-1 h-3 w-3 text-success" />
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
                <div>
                  <h3 class="mb-3 flex items-center gap-2 text-sm font-bold text-secondary-text">
                    <Icon name="clipboard-list" class="h-3.5 w-3.5" /> ¿Qué aprenderás?
                  </h3>
                  <ul class="space-y-1.5 text-sm text-body">
                    {course.learnings.map((item) => (
                      <li class="flex gap-2">
                        <Icon name="check" class="mt-1 h-3 w-3 text-success" />
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <div>
                <h3 class="mb-4 text-lg font-semibold text-ink">Programa de 6 sesiones</h3>
                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                  {course.sessions.map((session, i) => (
                    <div class="rounded-xl border border-border bg-surface p-4">
                      <p class="mb-1 text-xs font-bold uppercase tracking-[0.1em] text-secondary-text">
                        Sesión {i + 1}
                      </p>
                      <p class="mb-1 text-sm font-semibold text-ink">{session.title}</p>
                      <p class="text-sm text-body">{session.text}</p>
                    </div>
                  ))}
                </div>
              </div>

              <div>
                <h3 class="mb-3 text-lg font-semibold text-ink">¿Qué incluye el programa?</h3>
                <ul class="space-y-1.5 text-sm text-body">
                  {course.includes.map((item) => (
                    <li class="flex gap-2">
                      <Icon name="check" class="mt-1 h-3 w-3 text-success" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div>
                <h3 class="mb-3 text-lg font-semibold text-ink">Metodología</h3>
                <p class="mb-3 text-sm text-body">Cada sesión combina tres componentes:</p>
                <ul class="space-y-2 text-sm text-body">
                  {course.methodology.map((item) => (
                    <li>
                      <span class="font-semibold text-ink">{item.title}:</span> {item.text}
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="flex w-full flex-col gap-4 rounded-2xl border border-border bg-surface p-6 lg:w-72 lg:flex-shrink-0 lg:self-start">
              <div class="flex h-14 w-14 items-center justify-center rounded-full bg-primary-soft">
                <Icon name={course.icon} class="h-7 w-7 text-primary-text" />
              </div>
              <p class="flex items-start gap-2 text-sm text-body">
                <Icon name="calendar-day" class="mt-0.5 h-4 w-4 flex-shrink-0 text-secondary-text" />
                {course.modality}
              </p>
              <Button href="#agenda" size="md" fullWidth class="mt-auto">
                Agendar este programa
              </Button>
            </div>
          </article>
        ))
      }
    </div>

    <p class="flex items-center justify-center gap-2 text-center text-lg font-bold text-ink">
      <Icon name="money-bill" class="h-5 w-5" />Valor de lanzamiento del Acompañamiento — $25.000
    </p>

    <AgendaForm courses={courses} />
  </main>
</BaseLayout>
