---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import Button from "../components/Button.astro";
import { socials } from "../data/socials.js";

const whatsappHref = "https://wa.me/56937062554?text=Hola%2C%20quiero%20saber%20m%C3%A1s%20sobre%20los%20acompa%C3%B1amientos%20de%20journaling";
---

<BaseLayout
  title="Contáctenos | Journaling Terapéutico"
  description="Ponte en contacto con Journaling Terapéutico y agenda tu acompañamiento de journaling con enfoque psicológico junto a Marina Vera."
  path="/contact.html"
  current="contact"
>
  <main class="mx-auto max-w-6xl px-6 py-16 md:px-10">
    <header class="mx-auto mb-14 max-w-2xl text-center">
      <h1 class="text-4xl font-bold text-ink md:text-5xl">Escribamos juntos tu nueva historia</h1>
      <p class="mt-4 text-lg text-body">
        Un espacio seguro para explorar tus pensamientos y emociones a través del journaling terapéutico.
        Estoy aquí para acompañarte.
      </p>
    </header>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-12">
      <!-- FORMULARIO -->
      <div class="rounded-2xl border border-border bg-card p-8 shadow-soft md:col-span-7">
        <h2 class="mb-6 text-2xl font-semibold text-ink">Déjame un mensaje</h2>
        <form method="POST" action="https://formspree.io/f/mgogryyq" class="space-y-5">
          <input type="hidden" name="_subject" value="Nuevo mensaje de contacto — Journaling Terapéutico" />
          <input type="hidden" name="_next" value="https://journalingenred.vercel.app/gracias.html" />
          <p class="hidden">
            <label>No llenar si eres humano: <input name="_gotcha" tabindex="-1" autocomplete="off" /></label>
          </p>
          <div>
            <label class="mb-1.5 block text-sm font-bold text-ink" for="name">Nombre completo</label>
            <input
              id="name"
              name="name"
              type="text"
              autocomplete="name"
              placeholder="Tu nombre"
              required
              class="form-input"
            />
          </div>
          <div>
            <label class="mb-1.5 block text-sm font-bold text-ink" for="email">Correo electrónico</label>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              placeholder="tu@email.com"
              required
              class="form-input"
            />
          </div>
          <div>
            <label class="mb-1.5 block text-sm font-bold text-ink" for="subject">Asunto</label>
            <input
              id="subject"
              name="subject"
              type="text"
              placeholder="Motivo de tu consulta"
              required
              class="form-input"
            />
          </div>
          <div>
            <label class="mb-1.5 block text-sm font-bold text-ink" for="message">Tu mensaje</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              placeholder="Escribe aquí lo que sientas necesario compartir..."
              required
              class="form-input resize-none"
            ></textarea>
          </div>
          <Button type="submit">Enviar mensaje</Button>
        </form>
      </div>

      <!-- INFO LATERAL -->
      <div class="flex flex-col gap-6 md:col-span-5">
        <div class="paper-lines rounded-2xl bg-primary-soft p-6 shadow-soft">
          <h3 class="mb-4 flex items-center gap-2 text-lg font-semibold text-ink">
            <Icon name="comments" class="h-4 w-4 text-primary-text" /> Contacto Directo
          </h3>
          <div class="space-y-3 text-sm text-body">
            <a href="mailto:lic.ps.marinaverag@gmail.com" class="flex items-center gap-2 transition hover:text-primary-text">
              <Icon name="envelope" class="h-4 w-4 text-primary-text" /> lic.ps.marinaverag@gmail.com
            </a>
            <p class="flex items-center gap-2">
              <Icon name="clock" class="h-4 w-4 text-primary-text" /> Lunes a Viernes, 10:00 - 17:00
            </p>
          </div>
          <a
            href={whatsappHref}
            target="_blank"
            rel="noopener"
            class="mt-5 flex w-full items-center justify-center gap-2 rounded-full border border-primary/30 bg-card px-5 py-3 text-sm font-bold text-ink transition hover:bg-surface"
          >
            <Icon name="whatsapp" class="h-4 w-4" /> Escribir por WhatsApp
          </a>
        </div>

        <div class="rounded-2xl border border-border bg-card p-6 shadow-soft">
          <h3 class="mb-4 text-lg font-semibold text-ink">Comunidad</h3>
          <div class="grid grid-cols-2 gap-3">
            {
              socials.map((social) => (
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener"
                  class="flex items-center gap-2 rounded-lg p-2 text-sm text-body transition hover:bg-surface hover:text-primary-text"
                >
                  <Icon name={social.icon} class="h-4 w-4" /> {social.name}
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
