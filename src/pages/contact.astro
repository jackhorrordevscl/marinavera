---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
---

<BaseLayout
  title="Contáctenos | Journaling Terapéutico"
  description="Ponte en contacto con Journaling Terapéutico y agenda tu acompañamiento de journaling con enfoque psicológico junto a Marina Vera."
  path="/contact.html"
  current="contact"
>
  <main class="mx-auto max-w-6xl px-6 py-16 md:px-10">
    <header class="mx-auto mb-14 max-w-2xl text-center">
      <h1 class="text-4xl font-bold text-primary md:text-5xl">Escribamos juntos tu nueva historia</h1>
      <p class="mt-4 text-lg text-body">
        Un espacio seguro para explorar tus pensamientos y emociones a través del journaling terapéutico.
        Estoy aquí para acompañarte.
      </p>
    </header>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-12">
      <!-- FORMULARIO -->
      <div class="rounded-2xl border border-border bg-card p-8 shadow-soft md:col-span-7">
        <h2 class="mb-6 text-2xl font-semibold text-primary">Déjame un mensaje</h2>
        <form
          name="contact"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="space-y-5"
        >
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden">
            <label>No llenar si eres humano: <input name="bot-field" /></label>
          </p>
          <div>
            <label class="mb-1.5 block text-sm font-bold text-secondary" for="name">Nombre completo</label>
            <input
              id="name"
              name="name"
              type="text"
              autocomplete="name"
              placeholder="Tu nombre"
              required
              class="w-full rounded-2xl border border-border bg-surface px-5 py-3.5 text-ink transition focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
            />
          </div>
          <div>
            <label class="mb-1.5 block text-sm font-bold text-secondary" for="email">Correo electrónico</label>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              placeholder="tu@email.com"
              required
              class="w-full rounded-2xl border border-border bg-surface px-5 py-3.5 text-ink transition focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
            />
          </div>
          <div>
            <label class="mb-1.5 block text-sm font-bold text-secondary" for="subject">Asunto</label>
            <input
              id="subject"
              name="subject"
              type="text"
              placeholder="Motivo de tu consulta"
              required
              class="w-full rounded-2xl border border-border bg-surface px-5 py-3.5 text-ink transition focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
            />
          </div>
          <div>
            <label class="mb-1.5 block text-sm font-bold text-secondary" for="message">Tu mensaje</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              placeholder="Escribe aquí lo que sientas necesario compartir..."
              required
              class="w-full resize-none rounded-2xl border border-border bg-surface px-5 py-3.5 text-ink transition focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
            ></textarea>
          </div>
          <button
            type="submit"
            class="rounded-full bg-primary px-8 py-3.5 font-bold text-white shadow-soft transition hover:-translate-y-0.5 hover:bg-primary-hover"
          >
            Enviar mensaje
          </button>
        </form>
      </div>

      <!-- INFO LATERAL -->
      <div class="flex flex-col gap-6 md:col-span-5">
        <div class="rounded-2xl bg-primary-soft p-6 shadow-soft">
          <h3 class="mb-4 flex items-center gap-2 text-lg font-semibold text-secondary">
            <Icon name="comments" class="h-4 w-4 text-primary" /> Contacto Directo
          </h3>
          <div class="space-y-3 text-sm text-body">
            <a href="mailto:lic.ps.marinaverag@gmail.com" class="flex items-center gap-2 transition hover:text-primary">
              <Icon name="envelope" class="h-4 w-4 text-primary" /> lic.ps.marinaverag@gmail.com
            </a>
            <p class="flex items-center gap-2">
              <Icon name="clock" class="h-4 w-4 text-primary" /> Lunes a Viernes, 10:00 - 17:00
            </p>
          </div>
          <a
            href="https://wa.me/56937062554"
            target="_blank"
            rel="noopener"
            class="mt-5 flex w-full items-center justify-center gap-2 rounded-full border border-primary/30 bg-card px-5 py-3 text-sm font-bold text-secondary transition hover:bg-surface"
          >
            <Icon name="whatsapp" class="h-4 w-4" /> Escribir por WhatsApp
          </a>
        </div>

        <div class="rounded-2xl border border-border bg-card p-6 shadow-soft">
          <h3 class="mb-4 text-lg font-semibold text-secondary">Comunidad</h3>
          <div class="grid grid-cols-2 gap-3">
            <a
              href="https://www.instagram.com/psico_marinade_colores"
              target="_blank"
              rel="noopener"
              class="flex items-center gap-2 rounded-lg p-2 text-sm text-body transition hover:bg-surface hover:text-primary"
              ><Icon name="instagram" class="h-4 w-4" /> Instagram</a
            >
            <a
              href="https://www.youtube.com/@Psico_marinadecolores"
              target="_blank"
              rel="noopener"
              class="flex items-center gap-2 rounded-lg p-2 text-sm text-body transition hover:bg-surface hover:text-primary"
              ><Icon name="youtube" class="h-4 w-4" /> YouTube</a
            >
            <a
              href="https://www.tiktok.com/@marinna_decolores"
              target="_blank"
              rel="noopener"
              class="flex items-center gap-2 rounded-lg p-2 text-sm text-body transition hover:bg-surface hover:text-primary"
              ><Icon name="tiktok" class="h-4 w-4" /> TikTok</a
            >
            <a
              href="https://www.facebook.com/people/Marinna-de-Colores/61582718874848/"
              target="_blank"
              rel="noopener"
              class="flex items-center gap-2 rounded-lg p-2 text-sm text-body transition hover:bg-surface hover:text-primary"
              ><Icon name="facebook-f" class="h-4 w-4" /> Facebook</a
            >
          </div>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
