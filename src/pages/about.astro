---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import type { IconName } from "../components/Icon.astro";
import Button from "../components/Button.astro";
import Card from "../components/Card.astro";
import fotoImg from "../assets/foto2.jpg";

interface Pillar {
  icon: IconName;
  title: string;
  text: string;
}

const pillars: Pillar[] = [
  {
    icon: "heart",
    title: "Expresión Emocional",
    text: "Canalizar sentimientos complejos en palabras, dando forma a lo que a menudo se siente inmanejable en la mente.",
  },
  {
    icon: "compass",
    title: "Autoconocimiento",
    text: "Explorar patrones de pensamiento y comportamiento para comprender tus motivaciones más profundas.",
  },
  {
    icon: "droplet",
    title: "Regulación Emocional",
    text: "Desarrollar anclas y herramientas escritas para volver a tu centro en momentos de sobrecarga.",
  },
  {
    icon: "cloud",
    title: "Manejo de Ansiedad",
    text: "Trabajar los patrones de pensamiento de la ansiedad mediante journaling guiado.",
  },
  {
    icon: "pen-fancy",
    title: "Narrativa y Re-significación",
    text: "Reconstruir tu narrativa personal a través de la escritura consciente.",
  },
  {
    icon: "puzzle-piece",
    title: "Integración y Síntesis",
    text: "Consolidar los aprendizajes y conectar las experiencias vividas durante el proceso.",
  },
];
---

<BaseLayout
  title="Sobre Nosotros | Journaling Terapéutico"
  description="Conoce el proyecto de Journaling Terapéutico y cómo la escritura guiada con enfoque psicológico puede acompañarte en tu autoconocimiento y bienestar emocional."
  path="/about.html"
  current="about"
>
  <main class="mx-auto flex max-w-6xl flex-col gap-20 px-6 py-16 md:px-10">
    <!-- PRESENTACIÓN -->
    <section class="grid grid-cols-1 items-center gap-10 md:grid-cols-12">
      <div class="relative md:col-span-5">
        <div class="absolute inset-0 -rotate-3 rounded-2xl bg-primary-soft"></div>
        <Image
          src={fotoImg}
          alt="Marina Vera, psicóloga y facilitadora de Journaling Terapéutico"
          loading="eager"
          class="relative h-[420px] w-full rounded-2xl object-cover shadow-lift"
        />
      </div>
      <div class="space-y-5 md:col-span-7 md:pl-6">
        <h1 class="text-4xl font-bold text-ink md:text-5xl">Un espacio seguro para tu mente.</h1>
        <p class="text-lg leading-relaxed text-body">
          A veces la mente se llena de pensamientos que no encuentran dónde acomodarse: ideas a medio armar,
          emociones sin nombre, preguntas que dan vueltas. El journaling terapéutico es un espacio para bajar
          todo eso al papel, mirarlo con calma y empezar a entender qué te está diciendo.
        </p>
        <p class="text-lg leading-relaxed text-body">
          Acá combinamos estructura profesional con la calidez de un acompañamiento cercano, inspirado en la
          simplicidad de un diario personal: cada pensamiento tiene un lugar. Guío este proceso desde mi
          formación como psicóloga — sin reemplazar la psicoterapia, pero sí como un complemento real para tu
          bienestar emocional.
        </p>
        <Button href="/class.html" variant="outline">Conoce los acompañamientos</Button>
      </div>
    </section>

    <hr class="border-border" />

    <!-- PILARES -->
    <section>
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="mb-3 text-3xl font-semibold text-ink">El valor de escribir</h2>
        <p class="text-lg text-body">
          A través del journaling terapéutico, trabajamos juntos estos pilares fundamentales para tu bienestar
          emocional.
        </p>
      </div>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          pillars.map((pillar, i) => (
            <Card class="paper-lines relative flex h-full flex-col overflow-hidden p-6">
              <span class="pointer-events-none absolute -top-4 -right-1 font-display text-7xl font-bold text-ink/5">
                {String(i + 1).padStart(2, "0")}
              </span>
              <div
                class={`relative mb-4 flex h-14 w-14 items-center justify-center rounded-full ${
                  i % 2 === 0 ? "bg-primary-soft" : "bg-secondary-soft"
                }`}
              >
                <Icon name={pillar.icon} class={`h-6 w-6 ${i % 2 === 0 ? "text-primary-text" : "text-secondary-text"}`} />
              </div>
              <h3 class="relative mb-2 text-lg font-semibold text-ink">{pillar.title}</h3>
              <p class="relative flex-grow text-sm text-body">{pillar.text}</p>
            </Card>
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>
