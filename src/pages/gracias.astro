---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import Button from "../components/Button.astro";
import { whatsappHref } from "../data/socials.js";
---

<BaseLayout
  title="¡Gracias! | Journaling En Red"
  description="Recibimos tu mensaje. Te contactaremos pronto."
  path="/gracias.html"
>
  <main class="mx-auto flex max-w-2xl flex-col items-center gap-6 px-6 py-24 text-center md:px-10">
    <Icon name="pen-nib" class="h-12 w-12 text-primary-text" />
    <h1 class="text-3xl font-bold text-ink md:text-4xl">¡Gracias por escribirnos!</h1>
    <p class="text-lg text-body">
      Recibimos tu mensaje y te contactaremos a la brevedad. Si tu consulta es urgente, también puedes
      escribirnos directo por WhatsApp.
    </p>
    <div class="mt-4 flex flex-col gap-3 sm:flex-row">
      <Button href="/">Volver a Inicio</Button>
      <Button href={whatsappHref} target="_blank" rel="noopener" variant="outline">
        Escribir por WhatsApp
      </Button>
    </div>
  </main>
</BaseLayout>
