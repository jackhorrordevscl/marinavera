---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import AgendaForm from "../components/AgendaForm.astro";
import Icon from "../components/Icon.astro";
import type { IconName } from "../components/Icon.astro";
import Button from "../components/Button.astro";
import Card from "../components/Card.astro";
import { courses } from "../data/courses.js";
import { testimonials } from "../data/testimonials.js";
import heroImg from "../assets/hero.webp";
import tiktokImg from "../assets/tiktok.webp";
import rrss2Img from "../assets/rrss2.webp";
import rrss3Img from "../assets/rrss3.webp";

interface SocialPost {
  image: ImageMetadata;
  icon: IconName;
  title: string;
  text: string;
  href: string;
}

const socialPosts: SocialPost[] = [
  {
    image: tiktokImg,
    icon: "tiktok",
    title: "30 Días de Journaling",
    text: "Ideas para no agotar tus recursos creativos. Lo importante es disfrutar tu proceso y tu journal.",
    href: "https://www.tiktok.com/@marinna_decolores/photo/7547021458174708997",
  },
  {
    image: rrss2Img,
    icon: "tiktok",
    title: "Todo lo que tienes que saber antes de entrar al journaling",
    text: "Poner en un lugar físico aquello que sentimos mejora de manera considerable nuestra salud mental.",
    href: "https://www.tiktok.com/@marinna_decolores/photo/7542587523487354117",
  },
  {
    image: rrss3Img,
    icon: "tiktok",
    title: "¿Tienes un Vision Board?",
    text: "El journaling es una estrategia de metacognición: observar los propios pensamientos y regular emociones.",
    href: "https://www.tiktok.com/@marinna_decolores/photo/7592403331981593863",
  },
];
---

<BaseLayout
  title="Journaling En Red | Acompañamiento con Enfoque Psicosocial"
  description="Journaling con enfoque psicosocial: bienestar, participación y vínculos comunitarios mediante escritura guiada."
  path="/"
  current="index"
>
  <!-- HERO -->
  <section class="relative isolate flex min-h-[480px] items-center overflow-hidden md:min-h-[600px]">
    <Image
      src={heroImg}
      alt="Manos decorando un diario con encaje, botones y papelería sobre un escritorio de madera"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-20 h-full w-full object-cover"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-ink via-ink/75 to-ink/10"></div>
    <div class="w-full px-6 py-20 md:px-10">
      <div class="mx-auto flex max-w-6xl flex-col items-start gap-5 text-left">
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-primary">Journaling con enfoque psicosocial</p>
        <h1 class="w-full max-w-xl text-4xl font-bold leading-tight text-white md:text-5xl">
          Journaling como acompañamiento psicosocial
        </h1>
        <p class="max-w-md text-lg text-white/85">
          Un espacio diseñado para fortalecer el bienestar, la participación y los vínculos comunitarios mediante
          experiencias de escritura guiada con enfoque psicosocial.
        </p>
        <Button href="#agenda" class="mt-2">Agenda tu cupo</Button>
      </div>
    </div>
  </section>

  <main class="flex flex-col gap-24 py-16">
    <!-- QUÉ ES -->
    <section class="mx-auto max-w-3xl px-6 text-center md:px-10">
      <h2 class="mb-4 text-3xl font-semibold text-ink">¿Qué es el journaling con enfoque psicosocial?</h2>
      <p class="text-lg leading-relaxed text-body">
        Es un espacio para detenerte, reflexionar y conectar con otras personas desde la escritura. A través de
        experiencias guiadas, favorece la expresión, el intercambio de vivencias y la construcción colectiva de
        significados, fortaleciendo el bienestar, los vínculos y los recursos personales y comunitarios. No
        reemplaza procesos psicoterapéuticos, pero puede contribuir al bienestar individual y colectivo.
      </p>
    </section>

    <!-- ACOMPAÑAMIENTOS -->
    <section class="mx-auto w-full max-w-6xl px-6 md:px-10">
      <h2 class="mb-10 text-center text-2xl font-semibold text-ink">Acompañamientos Destacados</h2>
      <div class={`grid grid-cols-1 gap-6 ${courses.length > 1 ? "md:grid-cols-3" : "mx-auto max-w-sm"}`}>
        {
          courses.map((course) => (
            <Card class="flex h-full flex-col p-6">
              <div class="mb-4 h-48 w-full overflow-hidden rounded-xl bg-primary-soft">
                <Image
                  src={course.cardImage}
                  alt={course.shortTitle}
                  loading="lazy"
                  class="h-full w-full object-cover"
                />
              </div>
              <span class="mb-3 w-fit max-w-full truncate rounded-full bg-secondary-soft px-3 py-1 text-xs font-bold text-secondary-text">
                {course.badge}
              </span>
              <h3 class="mb-2 text-lg font-semibold text-ink">{course.shortTitle}</h3>
              <p class="mb-4 flex-grow text-sm text-body">{course.summary}</p>
              <a
                href={`/class.html#${course.slug}`}
                class="group flex items-center gap-1 text-sm font-bold text-secondary-text underline underline-offset-2"
              >
                Ver más <Icon name="arrow-right" class="h-3 w-3 transition-transform group-hover:translate-x-1" />
              </a>
            </Card>
          ))
        }
      </div>
      <p class="mt-10 flex items-center justify-center gap-2 text-center text-lg font-bold text-ink">
        <Icon name="money-bill" class="h-5 w-5" />Valor de lanzamiento del Acompañamiento — $25.000
      </p>
    </section>

    <!-- AGENDA -->
    <div class="mx-auto w-full max-w-6xl px-6 md:px-10">
      <AgendaForm courses={courses} heading="Comienza tu Diario Hoy" />
    </div>

    <!-- TESTIMONIOS -->
    <section class="mx-auto w-full max-w-6xl px-6 md:px-10">
      <h2 class="mb-10 text-center text-2xl font-semibold text-ink">Páginas de Resignificación</h2>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {
          testimonials.map((t) => (
            <div class="paper-lines relative rounded-2xl bg-card p-8 shadow-soft">
              <Icon name="quote-left" class="absolute left-6 top-6 h-6 w-6 text-primary-soft" />
              <p class="relative mt-6 italic leading-relaxed text-body">"{t.quote}"</p>
              <p class="mt-4 text-sm font-bold text-secondary-text">— {t.name}, {t.role}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- REDES SOCIALES -->
    <section class="mx-auto w-full max-w-6xl px-6 md:px-10">
      <h2 class="mb-10 text-center text-2xl font-semibold text-ink">Últimos Artículos de Nuestras Redes</h2>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {
          socialPosts.map((post) => (
            <Card class="overflow-hidden">
              <Image src={post.image} alt={post.title} loading="lazy" class="h-44 w-full object-cover" />
              <div class="p-5">
                <h3 class="mb-2 flex items-center gap-2 text-base font-semibold text-ink">
                  <Icon name={post.icon} class="h-4 w-4 text-primary-text" />
                  {post.title}
                </h3>
                <p class="mb-4 text-sm text-body">{post.text}</p>
                <Button href={post.href} target="_blank" rel="noopener" size="sm">
                  Visitar
                </Button>
              </div>
            </Card>
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>
