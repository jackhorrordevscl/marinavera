---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import AgendaForm from "../components/AgendaForm.astro";
import Icon from "../components/Icon.astro";
import { courses } from "../data/courses.js";
import heroImg from "../assets/header.webp";
import tiktokImg from "../assets/tiktok.webp";
import rrss2Img from "../assets/rrss2.webp";
import rrss3Img from "../assets/rrss3.webp";

const testimonials = [
  {
    quote: "El journaling terapéutico me permitió profundizar en mis procesos emocionales y fortalecer mi autocuidado diario.",
    name: "María Gonzalez (32)",
    role: "Psicóloga",
  },
  {
    quote: "Aprendí a entender lo que sentía sin juzgarme. La escritura se volvió un espacio seguro para mí.",
    name: "Camila Rojas (21)",
    role: "Estudiante",
  },
  {
    quote: "Los ejercicios me ayudaron a ordenar mis pensamientos y reducir la ansiedad de forma práctica y constante.",
    name: "Andrés Muñoz (38)",
    role: "Ing. Comercial",
  },
];

const socialPosts = [
  {
    image: tiktokImg,
    icon: "tiktok",
    title: "30 Días de Journaling",
    text: "Ideas para no agotar tus recursos creativos. Lo importante es disfrutar tu proceso y tu journal.",
    href: "https://www.tiktok.com/@marinna_decolores/photo/7547021458174708997",
  },
  {
    image: rrss2Img,
    icon: "tiktok",
    title: "Todo lo que tienes que saber antes de entrar al journaling",
    text: "Poner en un lugar físico aquello que sentimos mejora de manera considerable nuestra salud mental.",
    href: "https://www.tiktok.com/@marinna_decolores/photo/7542587523487354117",
  },
  {
    image: rrss3Img,
    icon: "tiktok",
    title: "¿Tienes un Vision Board?",
    text: "El journaling es una estrategia de metacognición: observar los propios pensamientos y regular emociones.",
    href: "https://www.tiktok.com/@marinna_decolores/photo/7592403331981593863",
  },
];
---

<BaseLayout
  title="Journaling Terapéutico | Marina Vera - Acompañamiento con Enfoque Psicológico"
  description="Journaling con enfoque psicológico: autorregulación, claridad emocional y crecimiento personal. Acompañamientos individuales con Marina Vera."
  path="/"
  current="index"
>
  <main class="mx-auto flex max-w-6xl flex-col gap-24 px-6 py-16 md:px-10">
    <!-- HERO -->
    <section class="flex flex-col items-center gap-10 md:flex-row">
      <div class="flex w-full flex-col items-start gap-5 text-left md:w-1/2">
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-secondary-text">Journaling con enfoque psicológico</p>
        <h1 class="text-4xl font-bold leading-tight text-ink md:text-5xl">
          Tu escritura como camino de sanación
        </h1>
        <p class="max-w-md text-lg text-body">
          Un espacio para detenerte, escucharte y ordenar lo que sientes, a través de la escritura guiada con
          base en evidencia psicológica.
        </p>
        <a
          href="#agenda"
          class="mt-2 rounded-full bg-primary px-8 py-3.5 font-bold text-ink shadow-soft transition hover:-translate-y-0.5 hover:bg-primary-hover"
        >
          Agenda tu cupo
        </a>
      </div>
      <div class="relative h-80 w-full overflow-hidden rounded-2xl bg-primary-soft shadow-soft md:h-96 md:w-1/2">
        <Image
          src={heroImg}
          alt="Ilustración de una persona escribiendo en su diario de journaling"
          loading="eager"
          fetchpriority="high"
          class="h-full w-full object-cover"
        />
      </div>
    </section>

    <!-- QUÉ ES -->
    <section class="mx-auto max-w-3xl text-center">
      <h2 class="mb-4 text-3xl font-semibold text-ink">¿Qué es el journaling con enfoque psicológico?</h2>
      <p class="text-lg leading-relaxed text-body">
        Es un espacio para detenerte, escucharte y entender lo que pasa dentro de ti. A través de la escritura,
        te ayuda a ordenar pensamientos, conectar con tus emociones y darles un sentido más claro, sin juicio
        y a tu propio ritmo. No reemplaza procesos psicoterapéuticos, pero puede complementar tu bienestar
        emocional.
      </p>
    </section>

    <!-- ACOMPAÑAMIENTOS -->
    <section>
      <h2 class="mb-10 text-center text-2xl font-semibold text-ink">Acompañamientos Destacados</h2>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {
          courses.map((course) => (
            <div class="flex h-full flex-col rounded-2xl border border-border bg-card p-6 shadow-soft transition duration-300 hover:-translate-y-1 hover:shadow-lift">
              <div class="mb-4 h-48 w-full overflow-hidden rounded-xl bg-primary-soft">
                <Image
                  src={course.cardImage}
                  alt={course.shortTitle}
                  loading="lazy"
                  class="h-full w-full object-cover"
                />
              </div>
              <span class="mb-3 w-max rounded-full bg-secondary-soft px-3 py-1 text-xs font-bold text-secondary-text">
                {course.badge}
              </span>
              <h3 class="mb-2 text-lg font-semibold text-ink">{course.shortTitle}</h3>
              <p class="mb-4 flex-grow text-sm text-body">{course.summary}</p>
              <a
                href={`/class.html#${course.slug}`}
                class="flex items-center gap-1 text-sm font-bold text-secondary-text underline underline-offset-2"
              >
                Ver más <Icon name="arrow-right" class="h-3 w-3" />
              </a>
            </div>
          ))
        }
      </div>
      <p class="mt-10 flex items-center justify-center gap-2 text-center text-lg font-bold text-ink">
        <Icon name="money-bill" class="h-5 w-5" />Valor de lanzamiento del Acompañamiento — $25.000
      </p>
    </section>

    <!-- AGENDA -->
    <AgendaForm courses={courses} heading="Comienza tu Diario Hoy" />

    <!-- TESTIMONIOS -->
    <section>
      <h2 class="mb-10 text-center text-2xl font-semibold text-ink">Páginas de Sanación</h2>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {
          testimonials.map((t) => (
            <div class="paper-lines relative rounded-2xl bg-card p-8 shadow-soft">
              <Icon name="quote-left" class="absolute left-6 top-6 h-6 w-6 text-primary-soft" />
              <p class="relative mt-6 italic leading-relaxed text-body">"{t.quote}"</p>
              <p class="mt-4 text-sm font-bold text-secondary-text">— {t.name}, {t.role}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- REDES SOCIALES -->
    <section>
      <h2 class="mb-10 text-center text-2xl font-semibold text-ink">Últimos Artículos de Nuestras Redes</h2>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {
          socialPosts.map((post) => (
            <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-soft transition hover:-translate-y-1 hover:shadow-lift">
              <Image src={post.image} alt={post.title} loading="lazy" class="h-44 w-full object-cover" />
              <div class="p-5">
                <h3 class="mb-2 flex items-center gap-2 text-base font-semibold text-ink">
                  <Icon name={post.icon} class="h-4 w-4 text-primary-text" />
                  {post.title}
                </h3>
                <p class="mb-4 text-sm text-body">{post.text}</p>
                <a
                  href={post.href}
                  target="_blank"
                  rel="noopener"
                  class="inline-block rounded-full bg-primary px-5 py-2 text-sm font-bold text-ink transition hover:bg-primary-hover"
                >
                  Visitar
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>
