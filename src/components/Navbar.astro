---
interface Props {
  current?: "index" | "about" | "class" | "contact";
}

const { current = "index" } = Astro.props;

const links = [
  { id: "index", href: "/", label: "Inicio" },
  { id: "about", href: "/about.html", label: "Acerca De Nosotros" },
  { id: "class", href: "/class.html", label: "Acompañamiento Personalizado" },
  { id: "contact", href: "/contact.html", label: "Contáctenos" },
];
---

<div class="container-fluid bg-light position-relative shadow">
  <nav class="navbar navbar-expand-lg bg-light navbar-light py-3 py-lg-0 px-0 px-lg-5">
    <a href="/" class="navbar-brand text-secondary" style="font-size: x-large">
      <i class="fas fa-pen-nib brand-icon"></i>
      <span class="text-primary">Journaling Terapéutico</span>
    </a>
    <button type="button" class="navbar-toggler" data-toggle="collapse" data-target="#navbarCollapse">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse justify-content-between" id="navbarCollapse">
      <div class="navbar-nav font-weight-bold mx-auto py-0">
        {
          links.map((link) => (
            <a
              href={link.href}
              class={`nav-item nav-link ${link.id === current ? "active" : ""}`}
            >
              {link.label}
            </a>
          ))
        }
      </div>
      <a href="/class.html" class="btn btn-primary px-4">Explora los Acompañamientos</a>
    </div>
  </nav>
</div>
