---
interface Props {
  current?: "index" | "about" | "class" | "contact";
}

const { current = "index" } = Astro.props;

const links = [
  { id: "index", href: "/", label: "Inicio" },
  { id: "about", href: "/about.html", label: "Acerca De Nosotros" },
  { id: "class", href: "/class.html", label: "Acompañamientos" },
  { id: "contact", href: "/contact.html", label: "Contáctenos" },
];
---

<nav class="sticky top-0 z-50 w-full border-b border-border/60 bg-surface/80 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4 md:px-10">
    <a href="/" class="flex items-center gap-3">
      <img src="/img/logo.png" alt="Journaling Terapéutico" class="h-10 w-10 rounded-full object-cover" />
      <span class="font-display text-lg font-semibold text-secondary">Journaling Terapéutico</span>
    </a>

    <div class="hidden items-center gap-8 md:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            class={`pb-1 text-sm font-bold tracking-wide transition-colors duration-200 ${
              link.id === current
                ? "border-b-2 border-primary text-primary"
                : "text-secondary hover:text-primary"
            }`}
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <a
      href="/class.html"
      class="hidden rounded-full bg-primary px-6 py-2.5 text-sm font-bold text-white shadow-soft transition hover:-translate-y-0.5 hover:bg-primary-hover md:inline-block"
    >
      Agendar Cita
    </a>

    <button
      id="nav-toggle"
      type="button"
      aria-label="Abrir menú"
      class="flex h-10 w-10 items-center justify-center rounded-full text-secondary md:hidden"
    >
      <i class="fa fa-bars text-xl"></i>
    </button>
  </div>

  <div id="nav-menu" class="hidden border-t border-border/60 px-6 py-4 md:hidden">
    <div class="flex flex-col gap-4">
      {
        links.map((link) => (
          <a
            href={link.href}
            class={`text-sm font-bold ${link.id === current ? "text-primary" : "text-secondary"}`}
          >
            {link.label}
          </a>
        ))
      }
      <a href="/class.html" class="mt-2 rounded-full bg-primary px-6 py-2.5 text-center text-sm font-bold text-white">
        Agendar Cita
      </a>
    </div>
  </div>
</nav>
