---
import Icon from "./Icon.astro";

interface Props {
  current?: "index" | "about" | "class" | "contact";
}

const { current } = Astro.props;

const ctaHref = current === "index" || current === "class" ? "#agenda" : "/class.html#agenda";

const links = [
  { id: "index", href: "/", label: "Inicio" },
  { id: "about", href: "/about.html", label: "Acerca De Nosotros" },
  { id: "class", href: "/class.html", label: "Acompañamientos" },
  { id: "contact", href: "/contact.html", label: "Contáctenos" },
];
---

<nav class="sticky top-0 z-50 w-full border-b border-border/60 bg-surface/80 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4 md:px-10">
    <a href="/" class="flex items-center gap-3">
      <img src="/img/logo.png" alt="" width="256" height="256" class="h-10 w-10 rounded-full object-cover" />
      <span class="font-display text-lg font-semibold text-ink">Journaling Terapéutico</span>
    </a>

    <div class="hidden items-center gap-8 md:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            class={`pb-1 text-sm font-bold tracking-wide transition-colors duration-200 ${
              link.id === current
                ? "border-b-2 border-primary text-ink"
                : "text-ink hover:text-primary-text"
            }`}
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <a
      href={ctaHref}
      class="hidden rounded-full bg-primary px-6 py-2.5 text-sm font-bold text-ink shadow-soft transition hover:-translate-y-0.5 hover:bg-primary-hover md:inline-block"
    >
      Agendar Cita
    </a>

    <button
      id="nav-toggle"
      type="button"
      aria-label="Abrir menú"
      aria-controls="nav-menu"
      aria-expanded="false"
      class="flex h-10 w-10 items-center justify-center rounded-full text-ink md:hidden"
    >
      <Icon name="bars" class="h-5 w-5" />
    </button>
  </div>

  <div id="nav-menu" class="hidden border-t border-border/60 px-6 py-4 md:hidden">
    <div class="flex flex-col gap-4">
      {
        links.map((link) => (
          <a
            href={link.href}
            class={`text-sm font-bold text-ink ${link.id === current ? "underline underline-offset-4" : ""}`}
          >
            {link.label}
          </a>
        ))
      }
      <a href={ctaHref} class="mt-2 rounded-full bg-primary px-6 py-2.5 text-center text-sm font-bold text-ink">
        Agendar Cita
      </a>
    </div>
  </div>
</nav>
