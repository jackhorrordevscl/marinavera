---
import { Icon as AstroIcon } from "astro-icon/components";

// Mapa de nombre semántico -> ícono real (fa6-solid / fa6-brands / fa6-regular vía Iconify).
// Antes el sitio cargaba el paquete COMPLETO de Font Awesome (~7000 íconos) desde un CDN
// externo para usar 23. Ahora cada ícono se inlinea como SVG en build, sin request externo.
const iconMap = {
  "angle-double-up": "fa6-solid:angles-up",
  "pen-nib": "fa6-solid:pen-nib",
  bars: "fa6-solid:bars",
  xmark: "fa6-solid:xmark",
  envelope: "fa6-solid:envelope",
  user: "fa6-solid:user",
  check: "fa6-solid:check",
  "clipboard-list": "fa6-solid:clipboard-list",
  "calendar-day": "fa6-solid:calendar-day",
  "money-bill": "fa6-solid:money-bill",
  comments: "fa6-solid:comments",
  "arrow-right": "fa6-solid:arrow-right",
  "quote-left": "fa6-solid:quote-left",
  compass: "fa6-solid:compass",
  "pen-fancy": "fa6-solid:pen-fancy",
  bullhorn: "fa6-solid:bullhorn",
  handshake: "fa6-solid:handshake",
  brain: "fa6-solid:brain",
  "share-nodes": "fa6-solid:share-nodes",
  toolbox: "fa6-solid:toolbox",
  whatsapp: "fa6-brands:whatsapp",
  instagram: "fa6-brands:instagram",
  tiktok: "fa6-brands:tiktok",
  youtube: "fa6-brands:youtube",
  "facebook-f": "fa6-brands:facebook-f",
  clock: "fa6-regular:clock",
};

export type IconName = keyof typeof iconMap;

interface Props {
  name: IconName;
  class?: string;
  id?: string;
}

const { name, class: className, id } = Astro.props;
const resolved = iconMap[name];
---

<AstroIcon name={resolved} id={id} class={className} aria-hidden="true" />
