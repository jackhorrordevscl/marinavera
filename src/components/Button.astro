---
interface Props {
  href?: string;
  type?: "button" | "submit";
  variant?: "primary" | "outline";
  size?: "sm" | "md" | "lg";
  fullWidth?: boolean;
  class?: string;
  target?: string;
  rel?: string;
}

const {
  href,
  type = "button",
  variant = "primary",
  size = "lg",
  fullWidth = false,
  class: className = "",
  target,
  rel,
} = Astro.props;

const sizes = {
  sm: "px-5 py-2 text-sm",
  md: "px-6 py-2.5 text-sm",
  lg: "px-8 py-3.5",
};

const variants = {
  primary: "bg-primary text-ink shadow-soft hover:bg-primary-hover",
  outline: "border-2 border-secondary text-secondary-text hover:bg-secondary-soft",
};

const classes = [
  "inline-flex items-center justify-center gap-1.5 rounded-full font-bold transition hover:-translate-y-0.5",
  sizes[size],
  variants[variant],
  fullWidth ? "w-full" : "",
  className,
]
  .filter(Boolean)
  .join(" ");
---

{
  href ? (
    <a href={href} target={target} rel={rel} class={classes}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes}>
      <slot />
    </button>
  )
}
