---
import Icon from "./Icon.astro";
import { socials } from "../data/socials.js";

const year = new Date().getFullYear();
const whatsappHref = "https://wa.me/56937062554?text=Hola%2C%20quiero%20saber%20m%C3%A1s%20sobre%20los%20acompa%C3%B1amientos%20de%20journaling";
---

<footer class="mt-24 rounded-t-3xl bg-ink text-white">
  <div class="mx-auto grid max-w-6xl grid-cols-1 gap-10 px-6 py-16 md:grid-cols-3 md:px-10">
    <div class="space-y-3">
      <a href="/" class="flex items-center gap-2 font-display text-lg font-semibold text-white">
        <Icon name="pen-nib" class="h-4 w-4 text-primary" />
        Journaling En Red
      </a>
      <p class="max-w-xs text-sm text-white/75">
        Los acompañamientos tienen un enfoque de apoyo y autoconocimiento. No reemplazan la terapia psicológica
        ni el tratamiento con profesionales de la salud mental. Si experimentas malestar intenso o sostenido,
        es recomendable buscar atención psicológica especializada.
      </p>
      <p class="pt-2 text-xs text-white/70">© {year} Journaling En Red. Todos los derechos reservados.</p>
    </div>

    <div class="space-y-3">
      <h3 class="text-sm font-bold uppercase tracking-wide text-white">Contacto</h3>
      <a href="mailto:journalingenred@gmail.com" class="flex items-center gap-2 text-sm text-white/80 transition hover:text-primary">
        <Icon name="envelope" class="h-4 w-4" />journalingenred@gmail.com
      </a>
      <a href={whatsappHref} target="_blank" rel="noopener" class="flex items-center gap-2 text-sm text-white/80 transition hover:text-primary">
        <Icon name="whatsapp" class="h-4 w-4" />+56 9 3706 2554
      </a>
      <p class="flex items-center gap-2 text-sm text-white/80"><Icon name="clock" class="h-4 w-4" />Lunes a Viernes, 10:00 - 17:00</p>
    </div>

    <div class="space-y-3">
      <h3 class="text-sm font-bold uppercase tracking-wide text-white">Comunidad</h3>
      <div class="flex flex-wrap gap-4">
        {
          socials.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener"
              class="flex items-center gap-1.5 text-sm text-white/80 transition hover:text-primary"
            >
              <Icon name={social.icon} class="h-4 w-4" />
              {social.name}
            </a>
          ))
        }
      </div>
      <div class="flex flex-col gap-2 pt-2">
        <a href="/about.html" class="text-sm text-white/60 transition hover:text-primary">Sobre Nosotros</a>
        <a href="/class.html" class="text-sm text-white/60 transition hover:text-primary">Acompañamientos</a>
        <a href="/talleres.html" class="text-sm text-white/60 transition hover:text-primary">Talleres</a>
        <a href="/contact.html" class="text-sm text-white/60 transition hover:text-primary">Contáctenos</a>
      </div>
    </div>
  </div>
</footer>
