---
interface Course {
  title: string;
}

interface Props {
  courses: Course[];
  heading?: string;
}

const { courses, heading = "Agenda un cupo" } = Astro.props;
---

<section id="agenda" class="mx-auto max-w-2xl rounded-2xl bg-primary-soft p-8 shadow-soft md:p-14">
  <h2 class="mb-2 text-center text-2xl font-semibold text-ink md:text-3xl">{heading}</h2>
  <p class="mb-8 text-center text-sm text-body">Completa el formulario y te contactamos para coordinar tu primera sesión.</p>
  <form name="agenda" method="POST" action="/gracias.html" data-netlify="true" netlify-honeypot="agenda-bot-field" class="space-y-5">
    <input type="hidden" name="form-name" value="agenda" />
    <p class="hidden">
      <label>No llenar si eres humano: <input name="agenda-bot-field" /></label>
    </p>
    <div>
      <label class="mb-1.5 block text-sm font-bold text-ink" for="agenda-name">Nombre completo</label>
      <input
        id="agenda-name"
        type="text"
        name="name"
        autocomplete="name"
        placeholder="Tu nombre"
        required
        class="w-full rounded-2xl border border-border bg-card px-5 py-3.5 text-ink transition focus:border-primary-text focus:outline-none focus:ring-1 focus:ring-primary-text"
      />
    </div>
    <div>
      <label class="mb-1.5 block text-sm font-bold text-ink" for="agenda-email">Correo electrónico</label>
      <input
        id="agenda-email"
        type="email"
        name="email"
        autocomplete="email"
        placeholder="tu@email.com"
        required
        class="w-full rounded-2xl border border-border bg-card px-5 py-3.5 text-ink transition focus:border-primary-text focus:outline-none focus:ring-1 focus:ring-primary-text"
      />
    </div>
    <div>
      <label class="mb-1.5 block text-sm font-bold text-ink" for="agenda-course">Programa de interés</label>
      <select
        id="agenda-course"
        name="acompanamiento"
        required
        class="w-full rounded-2xl border border-border bg-card px-5 py-3.5 text-ink transition focus:border-primary-text focus:outline-none focus:ring-1 focus:ring-primary-text"
      >
        <option value="" selected disabled>Elige el acompañamiento</option>
        {courses.map((course) => <option value={course.title}>{course.title}</option>)}
      </select>
    </div>
    <button
      type="submit"
      class="w-full rounded-full bg-primary py-3.5 font-bold text-ink shadow-soft transition hover:-translate-y-0.5 hover:bg-primary-hover"
    >
      Agenda Ya!
    </button>
  </form>
</section>
